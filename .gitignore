### Rust template
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
.idea/

### Build artifacts — strongSwan / OpenSSL / xl2tpd
# Tarballs (downloaded by build script)
build-strongswan/*.tar.gz
build-strongswan/*.tar.bz2
build-strongswan/*.zip

# Extracted source trees
build-strongswan/strongswan-*/
build-strongswan/openssl-*/
build-strongswan/xl2tpd/

# Build output directories (intermediate)
build-strongswan/build-*/
build-strongswan/ssl-*/
build-strongswan/openssl-universal/

# Final universal binaries are copied to src-tauri/resources/ — those ARE committed
# But intermediate universal-* dirs in build-strongswan/ are NOT
build-strongswan/universal/
build-strongswan/universal-swanctl/
build-strongswan/universal-xl2tpd/

