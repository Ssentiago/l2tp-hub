{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L2TP Hub",
  "version": "1.0.0",
  "identifier": "com.sentiago.l2tp-hub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "L2TP Hub",
        "width": 640,
        "height": 480,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ipsec/*": "ipsec/",
      "resources/xl2tpd/*": "xl2tpd/",
      "resources/etc/*": "etc/",
      "resources/helper/*": "helper/",
      "resources/guardian/*": "guardian/"
    }
  }
}