<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sentiago.l2tp-hub.guardian</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/l2tp-hub-guardian</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/l2tp/guardian-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/l2tp/guardian-stderr.log</string>
</dict>
</plist>