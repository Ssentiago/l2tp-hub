  "errors": {
    "ike_auth_failed": {
      "message": "The server rejected IKE authentication",
      "hints": [
        "Check the pre-shared key (PSK) in the connection settings",
        "The key must match the one configured on the server"
      ]
    },
    "ike_no_proposal": {
      "message": "The server did not accept the encryption proposal",
      "hints": [
        "The IKE parameters on the server do not match ours",
        "Contact the server administrator to confirm the settings"
      ]
    },
    "ike_ts_unacceptable": {
      "message": "The server rejected the tunnel subnets",
      "hints": [
        "Check the split tunneling subnets",
        "The server may only allow specific networks"
      ]
    },
    "ike_cert_untrusted": {
      "message": "The server certificate or key failed verification",
      "hints": [
        "The server uses a key that the application does not trust"
      ]
    },
    "ike_peer_unreachable": {
      "message": "The server is not responding to IKE requests",
      "hints": [
        "Check the server address and internet connectivity",
        "A firewall or provider may be blocking UDP 500 and 4500"
      ]
    },
    "ppp_negotiation_failed": {
      "message": "PPP negotiation did not complete",
      "hints": [
        "IPSec is established but the PPP tunnel did not come up",
        "Check the session logs and the server settings"
      ]
    },
    "ppp_peer_auth_failed": {
      "message": "The server failed authentication at the PPP stage",
      "hints": [
        "The account is misconfigured on the server"
      ]
    },
    "ppp_our_auth_failed": {
      "message": "The server rejected the username or password",
      "hints": [
        "Check the login and password in the connection settings",
        "Make sure the account is active on the server"
      ]
    },
    "ppp_peer_dead": {
      "message": "The server dropped the PPP connection",
      "hints": [
        "The server stopped answering channel echo requests"
      ]
    },
    "ppp_killed": {
      "message": "The PPP daemon was terminated",
      "hints": [
        "The pppd process was killed after start, check the session logs"
      ]
    },
    "stack_failed": {
      "message": "The local VPN daemons failed to start",
      "hints": [
        "charon or xl2tpd did not start",
        "Restart the application; if it repeats, reinstall the helper"
      ]
    },
    "unknown": {
      "message": "Could not connect",
      "hints": [
        "The cause of the failure is unknown, open the session logs"
      ]
    }
  },
